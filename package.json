{
  "name": "@zeearth/mcp-server-docker",
  "version": "0.1.0",
  "description": "MCP server to inspect and manage Docker environments from AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "docker",
    "dockerode",
    "ssh",
    "ai",
    "claude"
  ],
  "author": "ZeEarth",
  "homepage": "https://github.com/zeearth/mcp-server-docker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeearth/mcp-server-docker.git"
  },
  "bugs": {
    "url": "https://github.com/zeearth/mcp-server-docker/issues"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-server-docker": "dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dockerode": "^5.0.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
